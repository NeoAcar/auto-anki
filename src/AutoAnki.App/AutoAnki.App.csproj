<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AutoAnki</AssemblyName>
    <RootNamespace>AutoAnki.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
    <Authors>AutoAnki contributors</Authors>
    <Description>Create English-to-Turkish Anki cards from selected text anywhere in Windows.</Description>
    <Product>AutoAnki</Product>
    <Copyright>Copyright © 2026 AutoAnki contributors</Copyright>
    <RepositoryUrl>https://github.com/NeoAcar/auto-anki</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoAnki.Core\AutoAnki.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
